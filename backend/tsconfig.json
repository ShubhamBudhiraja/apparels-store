{
    "compilerOptions": {
        "target": "es6",
        "module": "commonjs",
        "outDir": "api",
        "rootDir": "./src",
        "strict": true,
        "checkJs": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "moduleResolution": "node",
        "sourceMap": true,
        "baseUrl": "."
    },
    "include": ["./src/**/*"]
}
